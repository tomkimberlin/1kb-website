{
  "zone": "tomkimberlin.com",
  "settings": {
    "always_use_https": "off",
    "browser_cache_ttl": 0,
    "rocket_loader": "off",
    "email_obfuscation": "off",
    "automatic_https_rewrites": "off",
    "server_side_exclude": "off",
    "replace_insecure_js": "off"
  },
  "rulesets": [
    {
      "name": "Preserve visitor compression preferences",
      "kind": "zone",
      "phase": "http_request_late_transform",
      "rules": [
        {
          "action": "rewrite",
          "action_parameters": {
            "headers": {
              "x-onekb-accept-encoding": {
                "expression": "http.request.headers[\"accept-encoding\"][0]",
                "operation": "set"
              }
            }
          },
          "expression": "(http.host in {\"tomkimberlin.com\" \"www.tomkimberlin.com\"})",
          "enabled": true,
          "description": "Preserve visitor encoding preferences for the Worker before Cloudflare normalization"
        }
      ]
    },
    {
      "name": "Minimal personal website headers",
      "kind": "zone",
      "phase": "http_response_headers_transform",
      "rules": [
        {
          "action": "rewrite",
          "action_parameters": {
            "headers": {
              "accept-ranges": {
                "operation": "remove"
              },
              "etag": {
                "operation": "remove"
              },
              "last-modified": {
                "operation": "remove"
              },
              "nel": {
                "operation": "remove"
              },
              "priority": {
                "operation": "remove"
              },
              "report-to": {
                "operation": "remove"
              },
              "server-timing": {
                "operation": "remove"
              },
              "vary": {
                "operation": "set",
                "value": "accept-encoding"
              },
              "x-powered-by": {
                "operation": "remove"
              }
            }
          },
          "expression": "(http.host in {\"tomkimberlin.com\" \"www.tomkimberlin.com\"})",
          "enabled": true,
          "description": "Omit optional reporting and validators; preserve cache and protocol metadata"
        }
      ]
    }
  ]
}
