+static uintptr_t
+ngx_http_v3_encode_status(u_char *p, ngx_uint_t status)
+{
+    u_char      value[NGX_INT_T_LEN], *last;
+    ngx_uint_t  index;
+
+    /* RFC 9204 static status entries; all other values remain literals. */
+    switch (status) {
+    case 100: index = 63; break;
+    case 103: index = 24; break;
+    case 200: index = 25; break;
+    case 204: index = 64; break;
+    case 206: index = 65; break;
+    case 302: index = 66; break;
+    case 304: index = 26; break;
+    case 400: index = 67; break;
+    case 403: index = 68; break;
+    case 404: index = 27; break;
+    case 421: index = 69; break;
+    case 425: index = 70; break;
+    case 500: index = 71; break;
+    case 503: index = 28; break;
+    default:
+        last = ngx_sprintf(value, "%03ui", status);
+        return ngx_http_v3_encode_field_lri(p, 0,
+                                           NGX_HTTP_V3_HEADER_STATUS_200,
+                                           value, last - value);
+    }
+
+    return ngx_http_v3_encode_field_ri(p, 0, index);
+}
