--- /dev/null
+++ b/src/http/modules/ngx_http_ssl_brotli_cache.h
@@ -0,0 +1,166 @@
+/* Optional, bounded precompressed-certificate cache. Configuration-time only. */
+#ifndef NGX_HTTP_SSL_BROTLI_CACHE_H
+#define NGX_HTTP_SSL_BROTLI_CACHE_H
+#include <openssl/ssl.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <brotli/decode.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+
+#define NGX_SSL_CERT_BODY_LIMIT 65536
+#define NGX_SSL_CERT_CACHE_PATH_LIMIT 4096
+
+static int
+ngx_ssl_cert_cache_decode(const unsigned char *src, size_t len,
+    unsigned char *out, size_t expected)
+{
+    BrotliDecoderState *decoder;
+    BrotliDecoderResult result;
+    size_t left = expected, total = 0;
+
+    decoder = BrotliDecoderCreateInstance(NULL, NULL, NULL);
+    if (decoder == NULL) {
+        return 0;
+    }
+    result = BrotliDecoderDecompressStream(decoder, &len, &src, &left, &out,
+                                          &total);
+    BrotliDecoderDestroyInstance(decoder);
+    return result == BROTLI_DECODER_RESULT_SUCCESS && len == 0
+           && left == 0 && total == expected;
+}
+
+/* nginx has loaded private keys; the optimizer/byte validator needs only PEM. */
+static int
+ngx_ssl_cert_cache_single(SSL_CTX *ctx)
+{
+    X509 *selected = SSL_CTX_get0_certificate(ctx);
+    int count = 0;
+
+    if (selected == NULL) {
+        return 0;
+    }
+    if (SSL_CTX_set_current_cert(ctx, SSL_CERT_SET_FIRST)) {
+        do { count++; } while (SSL_CTX_set_current_cert(ctx, SSL_CERT_SET_NEXT));
+    }
+    return SSL_CTX_select_current_cert(ctx, selected) && count == 1;
+}
+
+/* 1 installs; 0 preserves the normal cache. NULL reason is an ordinary miss. */
+static int
+ngx_ssl_cert_cache_load(SSL_CTX *ctx, const char *directory,
+    const char **reason)
+{
+    static const char hex[] = "0123456789abcdef";
+    unsigned char *normal = NULL, *body = NULL, *candidate = NULL, *decoded = NULL;
+    unsigned char digest[EVP_MAX_MD_SIZE], extra;
+    unsigned int digest_len = 0;
+    size_t raw = 0, normal_len, length, offset, dir_len, i;
+    char *path = NULL;
+    int fd = -1, installed = 0, mark = ERR_set_mark();
+    ssize_t n;
+    struct stat st;
+
+    *reason = "cannot generate the configured Certificate body";
+    normal_len = SSL_CTX_get1_compressed_cert(ctx, TLSEXT_comp_cert_brotli,
+                                             &normal, &raw);
+    if (normal_len == 0 || raw == 0 || raw > NGX_SSL_CERT_BODY_LIMIT
+        || normal_len > NGX_SSL_CERT_BODY_LIMIT)
+    {
+        goto done;
+    }
+    *reason = "cannot allocate or decode the configured Certificate body";
+    body = OPENSSL_malloc(raw);
+    decoded = OPENSSL_malloc(raw);
+    if (body == NULL || decoded == NULL
+        || !ngx_ssl_cert_cache_decode(normal, normal_len, body, raw))
+    {
+        goto done;
+    }
+    if (!EVP_Digest(body, raw, digest, &digest_len, EVP_sha256(), NULL)
+        || digest_len != 32)
+    {
+        goto done;
+    }
+    dir_len = strlen(directory);
+    if (dir_len > NGX_SSL_CERT_CACHE_PATH_LIMIT - 69) {
+        *reason = "cache directory path is too long";
+        goto done;
+    }
+    path = OPENSSL_malloc(dir_len + 69);
+    if (path == NULL) {
+        goto done;
+    }
+    memcpy(path, directory, dir_len);
+    path[dir_len++] = '/';
+    for (i = 0; i < 32; i++) {
+        path[dir_len + 2*i] = hex[digest[i] >> 4];
+        path[dir_len + 2*i + 1] = hex[digest[i] & 15];
+    }
+    memcpy(path + dir_len + 64, ".br", 4);
+    fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd == -1) {
+        *reason = errno == ENOENT ? NULL : "cannot open cache entry";
+        goto done;
+    }
+    *reason = "cache entry must be a nonempty regular file smaller than default";
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0
+        || (unsigned long long) st.st_size >= normal_len)
+    {
+        goto done;
+    }
+    length = (size_t) st.st_size;
+    candidate = OPENSSL_malloc(length);
+    if (candidate == NULL) {
+        *reason = "cannot allocate cache entry";
+        goto done;
+    }
+    *reason = "cannot read a complete, stable cache entry";
+    offset = 0;
+    while (offset < length) {
+        n = read(fd, candidate + offset, length - offset);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            goto done;
+        }
+        offset += (size_t) n;
+    }
+    do { n = read(fd, &extra, 1); } while (n < 0 && errno == EINTR);
+    if (n != 0) {
+        goto done;
+    }
+    *reason = "cache entry does not exactly match the configured Certificate body";
+    if (!ngx_ssl_cert_cache_decode(candidate, length, decoded, raw)
+        || memcmp(body, decoded, raw) != 0)
+    {
+        goto done;
+    }
+    *reason = "cannot install validated cache entry";
+    installed = SSL_CTX_set1_compressed_cert(ctx, TLSEXT_comp_cert_brotli,
+                                           candidate, length, raw);
+    if (installed) {
+        *reason = NULL;
+    }
+
+done:
+    if (fd != -1) {
+        close(fd);
+    }
+    OPENSSL_free(path);
+    OPENSSL_free(normal);
+    OPENSSL_free(body);
+    OPENSSL_free(decoded);
+    OPENSSL_free(candidate);
+    if (mark) {
+        ERR_pop_to_mark();
+    } else {
+        ERR_clear_error();
+    }
+    return installed;
+}
+#endif
