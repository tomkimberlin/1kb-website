+static uintptr_t
+ngx_http_v3_encode_static_field(u_char *p, ngx_table_elt_t *header)
+{
+    ngx_str_t  *key, *value;
+
+    key = &header->key;
+    value = &header->value;
+
+    /* RFC 9204 static entries; unknown fields retain the literal encoder. */
+    if (key->len == 13
+        && ngx_strncasecmp(key->data, (u_char *) "cache-control", 13) == 0)
+    {
+        return ngx_http_v3_encode_field_lri(p, 0, 36, value->data, value->len);
+    }
+
+    if (key->len == 16
+        && ngx_strncasecmp(key->data, (u_char *) "content-encoding", 16) == 0)
+    {
+        if (value->len == 2 && ngx_strncmp(value->data, "br", 2) == 0) {
+            return ngx_http_v3_encode_field_ri(p, 0, 42);
+        }
+
+        if (value->len == 4 && ngx_strncmp(value->data, "gzip", 4) == 0) {
+            return ngx_http_v3_encode_field_ri(p, 0, 43);
+        }
+
+        return ngx_http_v3_encode_field_lri(p, 0, 42, value->data, value->len);
+    }
+
+    if (key->len == 4
+        && ngx_strncasecmp(key->data, (u_char *) "vary", 4) == 0)
+    {
+        if (value->len == 15
+            && ngx_strncmp(value->data, "accept-encoding", 15) == 0)
+        {
+            return ngx_http_v3_encode_field_ri(p, 0, 59);
+        }
+
+        return ngx_http_v3_encode_field_lri(p, 0, 59, value->data, value->len);
+    }
+
+    return ngx_http_v3_encode_field_l(p, key, value);
+}
