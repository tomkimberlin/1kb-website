+ngx_int_t
+ngx_http_v2_send_buffered_response(ngx_http_request_t *r, ngx_chain_t *out)
+{
+    ngx_int_t              rc, send_rc;
+    ngx_http_v2_stream_t  *stream;
+
+    stream = r->stream;
+
+    /* Defer only this synchronous header call, never a future body event. */
+    stream->coalesce_headers = 1;
+    rc = ngx_http_send_header(r);
+    stream->coalesce_headers = 0;
+
+    if (rc != NGX_ERROR && rc <= NGX_OK && !r->header_only) {
+        rc = ngx_http_output_filter(r, out);
+    }
+
+    /*
+     * Always drain pending headers, including filter errors, header-only
+     * transformations, a buffered body, and exhausted HTTP/2 flow control.
+     * filter_send preserves the ordinary write-event and buffered flags.
+     */
+    send_rc = ngx_http_v2_filter_send(r->connection, stream);
+
+    if (send_rc == NGX_ERROR) {
+        return NGX_ERROR;
+    }
+
+    return rc == NGX_OK ? send_rc : rc;
 }
 
 
