+/* Omit only the serializer's post-colon SP for HTTP/1.1 responses. */
+static u_char *
+ngx_http_copy_compact_header(u_char *dst, const void *data, size_t len,
+    ngx_uint_t compact)
+{
+    size_t         n;
+    const u_char  *src;
+
+    src = data;
+
+    if (compact) {
+        for (n = 0; n < len; n++) {
+            if (src[n] == ':') {
+                n++;
+                if (n < len && src[n] == ' ') {
+                    dst = ngx_cpymem(dst, src, n);
+                    return ngx_cpymem(dst, src + n + 1, len - n - 1);
+                }
+                break;
+            }
+        }
+    }
+
+    return ngx_cpymem(dst, src, len);
+}
